{
  "project": "Renzoverse Command Center",
  "version": "1.0.0",
  "modules": {
    "cavesharp": {
      "name": "CaveSharp-OS",
      "path": "modules/CaveSharp-OS/",
      "runtime": ".NET 8.0",
      "entry_point": "CaveSharpEngine.csproj",
      "telemetry_out": "shared/telemetry/cavesharp.json",
      "events_out": "shared/events/cavesharp_events.json"
    }
  },
  "pipes": {
    "telemetry_dir": "shared/telemetry/",
    "events_dir": "shared/events/",
    "agent_dir": "shared/agent/",
    "sync_interval_ms": 100
  }
}