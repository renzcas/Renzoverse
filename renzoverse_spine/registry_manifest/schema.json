{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:renzoverse:spine:registry-manifest:v1",
  "title": "Renzoverse Engine Registry Manifest",
  "description": "Local repository and engine declarations used by the Renzoverse control plane.",
  "type": "object",
  "required": [
    "project",
    "version",
    "modules",
    "pipes"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/module"
      }
    },
    "pipes": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "integer"
        ]
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "required": [
        "name",
        "path",
        "runtime",
        "entry_point",
        "launch",
        "prerequisites",
        "health_check",
        "telemetry_source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "entry_point": {
          "type": "string",
          "minLength": 1
        },
        "launch": {
          "type": "object",
          "required": [
            "working_directory",
            "argv"
          ],
          "properties": {
            "working_directory": {
              "type": "string",
              "minLength": 1
            },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "command",
              "minimum_version"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "minimum_version": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "health_check": {
          "type": "object",
          "required": [
            "kind",
            "startup_timeout_seconds"
          ],
          "properties": {
            "kind": {
              "const": "process"
            },
            "startup_timeout_seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "telemetry_source": {
          "type": "object",
          "required": [
            "kind",
            "path",
            "contract"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "contract": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "telemetry_out": {
          "type": "string",
          "minLength": 1
        },
        "events_out": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}