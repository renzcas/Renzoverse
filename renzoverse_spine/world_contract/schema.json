{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:renzoverse:spine:world:v1",
  "title": "Renzoverse World Definition",
  "description": "Stable authored definitions, separate from mutable simulation snapshots.",
  "type": "object",
  "required": [
    "schemaVersion",
    "worldId",
    "worldVersion",
    "name",
    "regions",
    "entityTypes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "worldId": {
      "type": "string",
      "minLength": 1
    },
    "worldVersion": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "regionId",
          "name"
        ],
        "properties": {
          "regionId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "parentRegionId": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "entityTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entityTypeId",
          "name"
        ],
        "properties": {
          "entityTypeId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
