{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:renzoverse:spine:event:v1",
  "title": "Renzoverse World Event",
  "description": "An ordered world-state change. Consumers use the per-world sequence to detect gaps and recover from a complete telemetry snapshot.",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "worldId",
    "sequence",
    "tick",
    "occurredAt",
    "eventType",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "worldId": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonically increasing sequence within a world, used to detect missing events."
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "sourceModuleId": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
